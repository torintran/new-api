# Copy thành deploy/k3s/secrets/app-secrets.env rồi điền giá trị thật.
# deploy/k3s/secrets/ đã gitignore. KHÔNG commit file .env.
#
# SESSION_SECRET: openssl rand -hex 32
# Giữ nguyên giá trị này sau lần chạy đầu. App dùng nó làm CRYPTO_SECRET
# khi CRYPTO_SECRET không được set riêng. Đổi secret sau khi đã lưu channel
# sẽ không giải mã được API key đã ghi trong database.
#
# PUBLIC_ORIGIN: origin HTTPS đúng của console, không path, không wildcard.
# Ví dụ: https://api.example.com
# Phải trùng hostname bạn thêm vào Cloudflare Tunnel.
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
PUBLIC_ORIGIN=https://newapi.example.com
